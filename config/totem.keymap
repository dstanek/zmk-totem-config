//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define MOUSE 4
#define MEDIA 5

&mt {
    quick-tap-ms = <100>;
    require-prior-idle-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
};

// Layer taps deliberately have NO require-prior-idle-ms. A modifier is almost
// always preceded by a pause, so the guard suits &mt; a symbol layer is not,
// because a bracket is wanted mid-burst. This mirrors the (require-prior-idle 0)
// opt-out on D, K, Caps and Right Alt in the kanata config.
&lt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
};

/ {
    behaviors {
        // A slower layer tap for the outer pinky keys, which reach ADJ. That
        // layer is rarely needed, so the longer term keeps a lingering Esc or
        // apostrophe from landing on it by accident.
        lt_slow: lt_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <200>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            // Not on SYM, where Q and W are the digits 1 and 2 -- rolling
            // them to type "12" would otherwise fire Escape.
            layers = <BASE NAV ADJ>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            bindings = <
                  &kp Q       &kp W       &kp E         &kp R        &kp T            &kp Y        &kp U        &kp I          &kp O       &kp P
                  &mt LSHFT A &mt LALT S  &lt SYM D     &mt LCTRL F  &kp G            &kp H        &mt RCTRL J  &lt SYM K      &mt RALT L  &mt RSHFT SEMI
&lt_slow ADJ ESC  &kp Z       &kp X       &kp C         &mt LGUI V   &kp B            &kp N        &mt RGUI M   &kp COMMA      &kp DOT     &kp SLASH       &lt_slow ADJ APOS
                                          &mo MOUSE     &lt MEDIA TAB &lt NAV SPACE    &lt SYM RET  &mt LGUI BSPC &sl SYM
            >;
        };

        nav_layer {
            label = "NAVI";

            bindings = <
            &kp ESC    &none         &none     &none          &none       &kp HOME  &kp PG_UP  &kp GRAVE &kp PG_DN  &none
            &kp LSHFT  &kp LALT      &none     &kp LCTRL      &none       &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &kp END
&caps_word  &kp DEL    &none         &kp CAPS  &none          &none       &none     &none      &none    &none      &none    &none
                                     &trans    &trans         &none       &trans    &kp LS(LGUI) &kp LGUI
            >;
        };

        sim_layer {
            label = "SYM";

            // The number row and the keys right of P on a regular keyboard,
            // brought within reach as plain keys, so Shift gives the usual
            // pair: { } on L and ;, _ + on H and J. K is empty because it is
            // one of the keys holding this layer, as is D. ! ( ) on S F G
            // save a Shift on the most common shifted symbols. Shift is on
            // A, on ; when held, and on the outer left thumb.

            bindings = <
             &kp N1     &kp N2     &kp N3     &kp N4      &kp N5        &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
             &kp LSHFT  &kp EXCL   &none      &kp LPAR    &kp RPAR      &kp MINUS  &kp EQUAL  &none      &kp LBKT   &mt RSHFT RBKT
&trans       &kp MINUS  &kp UNDER  &kp GRAVE  &trans      &kp BSLH      &kp PIPE   &kp DQT    &kp COMMA  &kp DOT    &kp SLASH  &trans
                                   &kp LSHFT  &gif       &trans        &trans     &kp C_PP   &trans
            >;
        };

        adjust_layer {
            label = "ADJ";

            bindings = <
              &sys_reset    &bt BT_CLR    &out OUT_TOG  &none         &none             &none   &kp F7  &kp F8  &kp F9  &kp F12
              &bootloader   &none         &none         &none         &none             &none   &kp F4  &kp F5  &kp F6  &kp F11
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL    &none   &kp F1  &kp F2  &kp F3  &kp F10  &none
                                          &trans        &trans        &trans            &trans  &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";

            // Getreu's arrangement. Motion on vim hjkl, the wheel on the row
            // below in the same order, buttons on the right thumbs, Mac
            // clipboard keys above the motion. Hold the outer left thumb on
            // base to reach the layer; once on it, tap Q to lock the layer
            // and tap Q again to release it.

            bindings = <
            &tog MOUSE &none         &none         &none         &none         &kp LS(LG(Z))       &kp LG(V)          &kp LG(C)        &kp LG(X)           &kp LG(Z)
            &none      &none         &none         &none         &none         &mmv MOVE_LEFT      &mmv MOVE_DOWN     &mmv MOVE_UP     &mmv MOVE_RIGHT     &none
&none       &none      &none         &none         &none         &none         &msc SCRL_LEFT      &msc SCRL_DOWN     &msc SCRL_UP     &msc SCRL_RIGHT     &none     &none
                                     &none         &none         &none         &mkp LCLK          &mkp MCLK        &mkp RCLK
            >;
        };

        media_layer {
            label = "MEDIA";

            // Media keys under the right hand, laid out like the NAV arrows:
            // previous, volume down, volume up, next on H J K L, brightness
            // above volume, mute on ;, play/pause on the right thumb. Mac
            // shortcuts under the left hand: screenshots on E R T (3 4 5 on
            // SYM), desktops and Mission Control on A S D F in the same
            // left-down-up-right order, Spotlight on G, region screenshot to
            // clipboard on C, emoji on V, lock screen on Q. Hold Tab.

            bindings = <
            &kp LC(LG(Q))  &none          &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))      &none          &kp C_BRI_DN   &kp C_BRI_UP   &none          &none
            &kp LC(LEFT)   &kp LC(DOWN)   &kp LC(UP)      &kp LC(RIGHT)   &kp LG(SPACE)       &kp C_PREV     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_NEXT     &kp C_MUTE
&none       &none          &none          &kp LC(LG(LS(N4)))  &kp LC(LG(SPACE))  &none    &none          &none          &none          &none          &none     &none
                                          &none           &none           &none           &kp C_PP       &none          &none
            >;
        };
    };
};
